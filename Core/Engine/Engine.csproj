<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>12.0</LangVersion>
	<PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
	<PublishSingleFile>true</PublishSingleFile>
	<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Authors>Elgen Tidwell</Authors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
    <DefineConstants>$(DefineConstants);CHISEL_GLSL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
    <DefineConstants>$(DefineConstants);CHISEL_GLSL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AssimpNet" Version="4.1.0" />
    <PackageReference Include="DeepCloner" Version="0.10.4" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.3.10" />
    <PackageReference Include="FreeImage.Standard" Version="4.3.8" />
    <PackageReference Include="Gum.MonoGame" Version="2025.11.30.1" />
    <PackageReference Include="JoltPhysicsSharp" Version="2.19.1" />
    <PackageReference Include="Lovebirb.MonoGame.SkinnedMeshImporter" Version="1.0.4" />
    <PackageReference Include="Magick.NET.Core" Version="14.11.1" />
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="MessagePack.Attributeless" Version="1.0.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.2.1105" />
    <PackageReference Include="MonoGame.Library.OpenAL" Version="1.24.3.2" />
	<PackageReference Include="MonoGame.Library.SDL" Version="2.32.10.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenTK.Audio.OpenAL" Version="4.9.4" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenAL.Extensions.Creative" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
    <PackageReference Include="System.Drawing.Common" Version="4.7.2" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.Json" Version="9.0.9" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
	  <PackageReference Include="NVorbis" Version="0.10.4" />
	  <PackageReference Include="System.Memory" Version="4.6.3" />
	  <PackageReference Include="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>
    <ItemGroup>
	    <EmbeddedResource Include="Content\GLSLShaders\**\*" />
    </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonoGame.Forked\MonoGame.Framework\MonoGame.Framework.DesktopGL.csproj" />
    <ProjectReference Include="..\MonoGame.ImGuiNet-main\MonoGame.ImGuiNet\Monogame.ImGuiNet.csproj" />
  </ItemGroup>
	<PropertyGroup>
		<MonoGamePlatform>DesktopGL</MonoGamePlatform>
	</PropertyGroup>
  <ItemGroup>
    <None Update="THIRD_PARTY_NOTICES.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
  <Import Project="..\..\Shared\ChiselSharedTypes\ChiselSharedTypes.projitems" Label="Shared" />
  <Import Project="..\..\Shared\ChiselModelTypes\ChiselModelTypes.projitems" Label="Shared" />
    <ItemGroup>
	    <None Include="joltc.dll" Link="runtimes\win-x64\native\joltc.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
	<ItemGroup>
		<None Include="joltc.dll" Link="runtimes\win-arm64\native\joltc.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>
	<ItemGroup>
		<None Include="joltc.dll" Link="runtimes\test_copy\native\joltc.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<!-- Don't worry about this below, it's just for me; it auto increments the build number on my machine. -->
	<!-- It won't find anything on yours, and that's exactly what's supposed to happen :) -->
	<PropertyGroup>
		<ChiselBuildScript>$(MSBuildThisFileDirectory)..\..\..\..\ChiselBuildBump.bat</ChiselBuildScript>
		<ChiselBuildInfoFile>$(MSBuildThisFileDirectory)BuildInfo.g.cs</ChiselBuildInfoFile>
	</PropertyGroup>

	<Target Name="ChiselBumpBuildNumber" BeforeTargets="CoreCompile">
		<Exec Command="&quot;$(ChiselBuildScript)&quot; &quot;$(ChiselBuildInfoFile)&quot;" Condition="Exists('$(ChiselBuildScript)')" ContinueOnError="WarnAndContinue" />
	</Target>
	
</Project>