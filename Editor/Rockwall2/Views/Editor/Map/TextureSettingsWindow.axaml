<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Rockwall2;assembly=Rockwall2"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="640"
        x:Class="Rockwall2.TextureSettingsWindow"
        x:CompileBindings="False"
        Title="Face Settings"
        Height="620" Width="640"
        MinHeight="620" MinWidth="640"
        Background="#202020"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Padding="0,0,0,0"
        Margin="0,0,0,0">

  <Border BorderThickness="1" BorderBrush="#686868">
    <DockPanel VerticalAlignment="Stretch" Margin="{Binding $parent[Window].OffScreenMargin}">
      <controls:RWTitleBar PointerPressed="TitleBar_PointerPressed"
                           PointerMoved="TitleBar_PointerMoved"
                           PointerReleased="TitleBar_PointerReleased"
                           VerticalAlignment="Top"/>
      <Grid>
        <TabControl>
			<TabItem Header="Texture Settings">
				<ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0F0F0F">
					<Grid Margin="16" ColumnDefinitions="*,Auto,*">

						<!-- Left half -->
						<StackPanel Grid.Column="0">

							<!-- Offset -->
							<TextBlock Foreground="Gray" Margin="0,4,0,2">Offset</TextBlock>
							<Grid ColumnDefinitions="*,*">
								<StackPanel Grid.Column="0" Orientation="Horizontal">
									<TextBlock VerticalAlignment="Center" Margin="0,0,4,0">X:</TextBlock>
									<NumericUpDown x:Name="tOffX" Value="0" Increment="1" FormatString="0"
												   ValueChanged="ValuesChanged"/>
								</StackPanel>
								<StackPanel Grid.Column="1" Orientation="Horizontal">
									<TextBlock VerticalAlignment="Center" Margin="0,0,4,0">Y:</TextBlock>
									<NumericUpDown x:Name="tOffY" Value="0" Increment="1" FormatString="0"
												   ValueChanged="ValuesChanged"/>
								</StackPanel>
							</Grid>

							<!-- Scale -->
							<TextBlock Foreground="Gray" Margin="0,4,0,2">Scale</TextBlock>
							<Grid ColumnDefinitions="*,*">
								<StackPanel Grid.Column="0" Orientation="Horizontal">
									<TextBlock VerticalAlignment="Center" Margin="0,0,4,0">X:</TextBlock>
									<NumericUpDown x:Name="tScaleX" Value="1" Increment="0.0625"
												   ValueChanged="ValuesChanged"/>
								</StackPanel>
								<StackPanel Grid.Column="1" Orientation="Horizontal">
									<TextBlock VerticalAlignment="Center" Margin="0,0,4,0">Y:</TextBlock>
									<NumericUpDown x:Name="tScaleY" Value="1" Increment="0.0625"
												   ValueChanged="ValuesChanged"/>
								</StackPanel>
							</Grid>

							<!-- Rotation -->
							<TextBlock Foreground="Gray" Margin="0,4,0,2">Rotation</TextBlock>
							<StackPanel Orientation="Horizontal" Spacing="4">
								<TextBlock VerticalAlignment="Center" Margin="0,0,4,0">Degrees:</TextBlock>
								<NumericUpDown x:Name="tRotation" Value="0" Minimum="-360" Maximum="360"
											   Increment="15" FormatString="0.0" Width="110" ValueChanged="ValuesChanged"/>
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="4">
								<Button Content="-90" Padding="6,2" Click="Rotate_Neg90"/>
								<Button Content="+90" Padding="6,2" Click="Rotate_Pos90"/>
								<Button Content="180" Padding="6,2" Click="Rotate_180"/>
							</StackPanel>

							<!-- Flip -->
							<TextBlock Foreground="Gray" Margin="0,4,0,2">Flip</TextBlock>
							<StackPanel Orientation="Horizontal">
								<ToggleButton x:Name="flipH" Content="Flip H" Padding="8,2" Margin="0,0,6,0"
											  IsCheckedChanged="ValuesChanged"/>
								<ToggleButton x:Name="flipV" Content="Flip V" Padding="8,2"
											  IsCheckedChanged="ValuesChanged"/>
							</StackPanel>

							<!-- Projection -->
							<TextBlock Foreground="Gray" Margin="0,4,0,2">UV Projection</TextBlock>
							<StackPanel Orientation="Horizontal">
								<RadioButton x:Name="projWorld" Content="World" GroupName="Proj"
											 Margin="0,0,12,0" IsChecked="True"
											 IsCheckedChanged="ValuesChanged"
											 ToolTip.Tip="Axes snapped to nearest world axis (classic Quake). Can stretch on angled faces."/>
								<RadioButton x:Name="projFace" Content="Face" GroupName="Proj"
											 IsCheckedChanged="ValuesChanged"
											 ToolTip.Tip="Axes projected onto the face plane. No stretching on angled faces (Valve 220 style)."/>
							</StackPanel>

							<!-- Luxel Scale -->
							<TextBlock Foreground="Gray" Margin="0,4,0,2">Lightmap</TextBlock>
							<StackPanel Orientation="Horizontal">
								<TextBlock VerticalAlignment="Center" Margin="0,0,4,0">Luxel scale:</TextBlock>
								<NumericUpDown x:Name="luxelScale" Value="1" Minimum="1" Maximum="128"
											   Increment="4" ValueChanged="ValuesChanged"/>
							</StackPanel>

						</StackPanel>

						<!-- Divider -->
						<Border Grid.Column="1" Width="1" Background="#3A3A3A" Margin="16,0"/>

						<!-- Right half -->
						<StackPanel Grid.Column="2">
							
							<!-- Justify -->
							<TextBlock Foreground="Gray" Margin="0,4,0,2">Justify</TextBlock>
							<Grid ColumnDefinitions="70,70,70" RowDefinitions="Auto,Auto" Width="210"
								  HorizontalAlignment="Left">
								<Button Grid.Row="0" Grid.Column="0" Content="Top"    Width="66" Height="28" HorizontalContentAlignment="Center" Margin="0,0,3,3" Padding="4,2" Click="Justify_Top"/>
								<Button Grid.Row="0" Grid.Column="1" Content="Center" Width="66" Height="28" HorizontalContentAlignment="Center" Margin="0,0,3,3" Padding="4,2" Click="Justify_Center"/>
								<Button Grid.Row="0" Grid.Column="2" Content="Bottom" Width="66" Height="28" HorizontalContentAlignment="Center" Margin="0,0,0,3" Padding="4,2" Click="Justify_Bottom"/>
								<Button Grid.Row="1" Grid.Column="0" Content="Left"   Width="66" Height="28" HorizontalContentAlignment="Center" Margin="0,0,3,0" Padding="4,2" Click="Justify_Left"/>
								<Button Grid.Row="1" Grid.Column="1" Content="Fit"    Width="66" Height="28" HorizontalContentAlignment="Center" Margin="0,0,3,0" Padding="4,2" Click="Justify_Fit"/>
								<Button Grid.Row="1" Grid.Column="2" Content="Right"  Width="66" Height="28" HorizontalContentAlignment="Center" Padding="4,2"                  Click="Justify_Right"/>
							</Grid>

							<!-- Reset -->
							<TextBlock Foreground="Gray" Margin="0,4,0,2">Reset</TextBlock>
							<StackPanel Orientation="Horizontal">
								<Button Content="All"    Padding="8,2" Width="66" HorizontalContentAlignment="Center" Margin="0,0,4,0" Click="Reset_All"/>
								<Button Content="Scale"  Padding="8,2" Width="66" HorizontalContentAlignment="Center" Margin="0,0,4,0" Click="Reset_Scale"/>
								<Button Content="Offset" Padding="8,2" Width="66" HorizontalContentAlignment="Center"                   Click="Reset_Offset"/>
							</StackPanel>

							<!-- Smoothing Groups -->
							<TextBlock Foreground="Gray" Margin="0,4,0,2">Smoothing Groups</TextBlock>
							<UniformGrid Columns="4" Rows="4" HorizontalAlignment="Left" Width="176">
								<ToggleButton x:Name="sg1"  Tag="1"  Content="1"  Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg2"  Tag="2"  Content="2"  Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg3"  Tag="3"  Content="3"  Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg4"  Tag="4"  Content="4"  Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg5"  Tag="5"  Content="5"  Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg6"  Tag="6"  Content="6"  Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg7"  Tag="7"  Content="7"  Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg8"  Tag="8"  Content="8"  Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg9"  Tag="9"  Content="9"  Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg10" Tag="10" Content="10" Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg11" Tag="11" Content="11" Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg12" Tag="12" Content="12" Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg13" Tag="13" Content="13" Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg14" Tag="14" Content="14" Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg15" Tag="15" Content="15" Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
								<ToggleButton x:Name="sg16" Tag="16" Content="16" Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,2" Click="SmoothingGroup_Click"/>
							</UniformGrid>

						</StackPanel>

					</Grid>
				</ScrollViewer>
			</TabItem>
          <TabItem Header="Terrain Edit">
            <ScrollViewer Background="#0F0F0F">
              <StackPanel Orientation="Vertical" Margin="16" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <Button Height="48" Padding="16" IsEnabled="false" x:Name="tCreate" Click="tCreate_Click">
                    <TextBlock VerticalAlignment="Center">
                      Create Terrain
                    </TextBlock>
                  </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <Button Height="48" Padding="16" IsEnabled="false" x:Name="tPMat" Click="tPMat_Click">
                    <TextBlock VerticalAlignment="Center">
                      Set 1st Material
                    </TextBlock>
                  </Button>
                  <Button Height="48" Padding="16" IsEnabled="false" x:Name="tSMat" Click="tSMat_Click">
                    <TextBlock VerticalAlignment="Center">
                      Set 2nd Material
                    </TextBlock>
                  </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock VerticalAlignment="Center">Power:</TextBlock>
                  <NumericUpDown ParsingNumberStyle="Integer" Value="2" Minimum="1" Maximum="8" x:Name="tPower">
                  </NumericUpDown>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock VerticalAlignment="Center">Mode:</TextBlock>
                  <ComboBox Width="214" x:Name="tModeDrop" SelectionChanged="ComboBox_SelectionChanged">
                    <ComboBoxItem>
                      <TextBlock Text="Shape" ToolTip.Tip="Shape the terrain with left and right click."/>
                    </ComboBoxItem>
                    <ComboBoxItem>
                      <TextBlock Text="Paint Alpha" ToolTip.Tip="Change alpha blend with left and right click."/>
                    </ComboBoxItem>
					<ComboBoxItem>
						<TextBlock Text="Smooth" ToolTip.Tip="Smooths harsh edges."/>
					</ComboBoxItem>
                  </ComboBox>
                </StackPanel>
				  <StackPanel Orientation="Horizontal" Spacing="16">
					  <TextBlock VerticalAlignment="Center">Move Direction:</TextBlock>
					  <ComboBox Width="214" x:Name="tMoveDrop" SelectedItem="Along Normal" SelectionChanged="MoveMode_SelectionChanged">
						  <ComboBoxItem>
							  <TextBlock Text="Along Normal" ToolTip.Tip="Move along the source face's normal."/>
						  </ComboBoxItem>
						  <ComboBoxItem>
							  <TextBlock Text="X Axis" ToolTip.Tip="Move along X."/>
						  </ComboBoxItem>
						  <ComboBoxItem>
							  <TextBlock Text="Y Axis" ToolTip.Tip="Move along Y."/>
						  </ComboBoxItem>
						  <ComboBoxItem>
							  <TextBlock Text="Z Axis" ToolTip.Tip="Move along Z."/>
						  </ComboBoxItem>
					  </ComboBox>
				  </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock VerticalAlignment="Center">Strength:</TextBlock>
                  <Slider Minimum="0" Maximum="10" Width="165" x:Name="tStrength"></Slider>
                  <TextBlock VerticalAlignment="Center" x:Name="tStrengthLabel">0</TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock VerticalAlignment="Center">Radius:</TextBlock>
                  <Slider Minimum="0" Maximum="10" Width="177" x:Name="tRadius"></Slider>
                  <TextBlock VerticalAlignment="Center" x:Name="tRadiusLabel">0</TextBlock>
                </StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="16">
					<Button Content="Sew Seams" Padding="8,2" Click="SewSeams_Click"/>
					<ToggleButton x:Name="tAutoSew" Content="Auto Sew" Padding="8,2"/>
				</StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
    </DockPanel>
  </Border>
</Window>
